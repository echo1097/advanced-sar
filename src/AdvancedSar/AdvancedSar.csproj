<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Version>0.6.1</Version>
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildProgramFiles32)/Steam/steamapps/common/Sea Power</GameDir>
    <ManagedDir>$(GameDir)/Sea Power_Data/Managed</ManagedDir>
    <BepInExCoreDir Condition="'$(BepInExCoreDir)' == '' And Exists('$(GameDir)/BepInEx/core/BepInEx.dll')">$(GameDir)/BepInEx/core</BepInExCoreDir>
    <BepInExCoreDir Condition="'$(BepInExCoreDir)' == ''">$(MSBuildProjectDirectory)/../../.tools/bepinex/BepInEx/core</BepInExCoreDir>
    <ModDir>$(MSBuildProjectDirectory)/../../dist/AdvancedSAR</ModDir>
    <DevModDir Condition="'$(DevModDir)' == ''">$(GameDir)/Sea Power_Data/StreamingAssets/AdvancedSAR-DEV</DevModDir>
    <DevModInfoFile>$(DevModDir)/_info.ini</DevModInfoFile>
    <DevModExpectedName>Advanced Search &amp; Rescue (DEV)</DevModExpectedName>
    <CopyToDevMod Condition="'$(CopyToDevMod)' == ''">true</CopyToDevMod>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../assets/life-ring.png" LogicalName="AdvancedSar.LifeRing.png" />
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Noesis.NoesisGUI">
      <HintPath>$(ManagedDir)/Noesis.NoesisGUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ParadoxNotion">
      <HintPath>$(ManagedDir)/ParadoxNotion.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Seapower-Scripts">
      <HintPath>$(ManagedDir)/Seapower-Scripts.dll</HintPath>
      <Private>false</Private>
      <ExternallyResolved>true</ExternallyResolved>
    </Reference>
    <Reference Include="UniRx">
      <HintPath>$(ManagedDir)/UniRx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ManagedDir)/UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckGameReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(ManagedDir)/UnityEngine.dll') Or !Exists('$(ManagedDir)/UnityEngine.CoreModule.dll')"
           Text="Sea Power's Unity assemblies were not found in '$(ManagedDir)'. Pass -p:GameDir with the folder containing Sea Power.exe." />
    <Error Condition="!Exists('$(BepInExCoreDir)/BepInEx.dll')"
           Text="BepInEx.dll was not found in '$(BepInExCoreDir)'. Set up Keel or pass -p:BepInExCoreDir with an extracted BepInEx 5 core folder." />
    <Error Condition="!Exists('$(BepInExCoreDir)/0Harmony.dll')"
           Text="0Harmony.dll was not found in the BepInEx core folder '$(BepInExCoreDir)'." />
    <Error Condition="!Exists('$(ManagedDir)/Noesis.NoesisGUI.dll') Or !Exists('$(ManagedDir)/ParadoxNotion.dll') Or !Exists('$(ManagedDir)/Seapower-Scripts.dll') Or !Exists('$(ManagedDir)/UniRx.dll')"
           Text="Sea Power's gameplay and UI assemblies were not found in '$(ManagedDir)'." />
  </Target>

  <Target Name="StageMod" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath);$(MSBuildProjectDirectory)/../../workshop/_info.ini;$(MSBuildProjectDirectory)/../../CHANGELOG.md"
          DestinationFolder="$(ModDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyToDevMod" AfterTargets="StageMod" Condition="'$(CopyToDevMod)' == 'true'">
    <PropertyGroup>
      <DevModFullPath>$([System.IO.Path]::GetFullPath('$(DevModDir)'))</DevModFullPath>
      <IsWorkshopPath>$([System.Text.RegularExpressions.Regex]::IsMatch('$(DevModFullPath)', '(?i)[\\/]workshop[\\/]content[\\/]'))</IsWorkshopPath>
    </PropertyGroup>

    <Error Condition="'$(IsWorkshopPath)' == 'true'"
           Text="Refusing to copy to '$(DevModFullPath)' because it looks like a Steam Workshop folder." />

    <Error Condition="!Exists('$(DevModDir)')"
           Text="Dev mod folder '$(DevModFullPath)' was not found. Create it or pass -p:CopyToDevMod=false." />

    <Error Condition="!Exists('$(DevModInfoFile)')"
           Text="Refusing to copy to '$(DevModFullPath)' because '_info.ini' was not found. Expected the dev install with Name=$(DevModExpectedName)." />

    <PropertyGroup>
      <DevModNamePattern>(?im)^\s*Name\s*=\s*$([System.Text.RegularExpressions.Regex]::Escape('$(DevModExpectedName)'))\s*$</DevModNamePattern>
      <HasDevLanguageSection>$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('$(DevModInfoFile)')), '(?im)^\s*\[Language_en\]\s*$'))</HasDevLanguageSection>
      <IsVerifiedDevMod>$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('$(DevModInfoFile)')), '$(DevModNamePattern)'))</IsVerifiedDevMod>
    </PropertyGroup>

    <Error Condition="'$(HasDevLanguageSection)' != 'true' Or '$(IsVerifiedDevMod)' != 'true'"
           Text="Refusing to copy to '$(DevModFullPath)' because '_info.ini' did not match '[Language_en]' with 'Name=$(DevModExpectedName)'." />

    <Copy SourceFiles="$(TargetPath);$(MSBuildProjectDirectory)/../../CHANGELOG.md"
          DestinationFolder="$(DevModDir)"
          SkipUnchangedFiles="true" />

    <Message Importance="High" Text="Verified _info.ini and synced dev build to '$(DevModFullPath)'." />
  </Target>
</Project>
